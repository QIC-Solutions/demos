# sshd del bastión de operaciones (demo). Se dejaron los algoritmos viejos
# para los TPV de 2012 que se administran por SSH.
Port 22
Protocol 2
HostKey /etc/ssh/ssh_host_rsa_key
HostKey /etc/ssh/ssh_host_dsa_key
KexAlgorithms diffie-hellman-group1-sha1,diffie-hellman-group14-sha1,curve25519-sha256,mlkem768x25519-sha256
Ciphers 3des-cbc,aes128-cbc,arcfour,aes256-gcm@openssh.com
MACs hmac-md5,hmac-sha1,hmac-sha2-256
HostKeyAlgorithms ssh-rsa,ssh-dss,ecdsa-sha2-nistp256
PubkeyAcceptedAlgorithms +ssh-rsa
PasswordAuthentication yes
PermitRootLogin no
